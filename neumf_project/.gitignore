.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Raw/processed data are local artifacts, not source code.
data/raw/**/*
!data/raw/**/.gitkeep
!data/raw/**/README.md
data/processed/**/*
!data/processed/**/.gitkeep
data/splits/**/*
!data/splits/**/.gitkeep

# Kết quả và checkpoint (*.pt, *.npz — mỗi file < 5 MB) đều được push để chạy lại demo/phân tích không cần train.
# Chỉ bỏ config tạm của multi-seed và thư mục kiểm tra tái lập tuning của scripts/18_preflight.py.
outputs/experiments/_temp_configs/
outputs/tuning_recheck/
# Chạy thử đánh giá cuối v2 trên tập xác thực của mẫu A (scripts/23_final_v2.py --dry-run) — số liệu không có ý nghĩa.
outputs/v2/dry_run/
outputs/v2/dry_run.log
# Dữ liệu đã lọc (scripts/02_prepare_data.py): sinh lại được bằng `python run.py prepare`, kiểm bằng MD5 trong
# outputs/data/manifest.json (manifest được commit) — không đẩy dữ liệu giao dịch H&M lên git.
outputs/data/*.csv.gz
