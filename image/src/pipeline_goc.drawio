        <mxCell id="p2_41" value="&lt;b&gt;Cấu hình: dùng lại từ H&amp;M&lt;/b&gt; (best_configs.json) — chỉ số epoch được chọn trên tập xác thực Amazon" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;spacing=4;fontSize=12;" vertex="1" parent="1">
