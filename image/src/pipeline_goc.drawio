        </mxCell>
        <mxCell id="p2_42" value="Hạn chế: chỉ có một bộ dữ liệu nên không có mẫu khách độc lập; một đánh giá không đồng nghĩa với một lần mua; Amazon không có thuộc tính khách (nhánh khách chỉ còn 2 đặc trưng thời gian)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#C00000;dashed=1;fillColor=none;fontColor=#C00000;align=center;verticalAlign=middle;spacing=4;fontSize=11;" vertex="1" parent="1">
