        <mxCell id="p2_44" value="&lt;b&gt;Sản phẩm — thuộc tính&lt;/b&gt;&lt;br&gt;11 thuộc tính: loại, nhóm, hoạ tiết, bộ phận…&lt;br&gt;embedding 8 chiều mỗi thuộc tính" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FCE7D9;strokeColor=#E6A15C;align=center;verticalAlign=middle;spacing=4;fontSize=11;" vertex="1" parent="1">
