        <mxCell id="c1" value="&lt;b style='font-size:15.5px'&gt;Nghiên cứu tài liệu&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14.0px;color:#4B5563'&gt;lọc cộng tác, nhân tử hoá ma trận, NeuMF, mô hình lai có đặc trưng&lt;/span&gt;" style="fontFamily=Segoe UI;shape=label;html=1;whiteSpace=wrap;rounded=1;arcSize=16;image=data:image/svg+xml,;imageWidth=38;imageHeight=38;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacing=9;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#B8C7D9;strokeWidth=1.6;fontSize=15.5;fontColor=#111827;" vertex="1" parent="1">
