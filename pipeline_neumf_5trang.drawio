=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FCE7D9;strokeColor=#E6A15C;fontSize=12;align=center;verticalAlign=middle;spacing=4;arcSize=0;" vertex="1" parent="1"><mxGeometry x="1220" y="422" width="228.273" height="20" as="geometry" /></mxCell><mxCell id="v82" value="6.080" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1454.27" y="418" width="80" height="28" as="geometry" /></mxCell><mxCell id="v83" value="49,8% đáp án là SP mới → mô hình chỉ dùng ID mất gần nửa đáp án; NDCG@10 báo riêng cho nhóm SP cũ / mới (src/evaluation/v2.py)." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=middle;fontSize=11;fontColor=#C00000;" vertex="1" parent="1"><mxGeometry x="1080" y="456" width="470" height="56" as="geometry" /></mxCell><mxCell id="v84" value="Giả định: doanh nghiệp biết trước danh mục sắp bán (thuộc tính, mô tả) nhưng không biết SP nào sẽ bán được (PREREG_v2 §2, §9)." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1080" y="520" width="470" height="56" as="geometry" /></mxCell><mxCell id="v85" value="Ràng buộc chống rò rỉ và kiểm tra" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#F5F5F5;strokeColor=#D6D6D6;fontSize=13;fontStyle=1;fontColor=#2F5597;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="614" width="1540" height="230" as="geometry" /></mxCell><mxCell id="v86" value="&lt;b&gt;Hai mẫu rời nhau&lt;/b&gt;&lt;br&gt;A ∩ B = ∅ ở cấp khách&lt;br&gt;md5 ghi trong PREREG_v2" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="654" width="240" height="100" as="geometry" /></mxCell><mxCell id="v87" value="&lt;b&gt;k-core trước mốc test&lt;/b&gt;&lt;br&gt;chỉ lọc trên cặp có ngày mua đầu &lt; 29/07/2020" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="315" y="654" width="240" height="100" as="geometry" /></mxCell><mxCell id="v88" value="&lt;b&gt;Đặc trưng theo thời điểm&lt;/b&gt;&lt;br&gt;tại ngày t chỉ dùng dữ liệu trước t · mẫu âm chỉ SP đã ra mắt" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="575" y="654" width="240" height="100" as="geometry" /></mxCell><mxCell id="v89" value="&lt;b&gt;Kiểm thử tự động&lt;/b&gt;&lt;br&gt;tests/test_v2.py&lt;br&gt;tests/test_v2_final.py" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="835" y="654" width="240" height="100" as="geometry" /></mxCell><mxCell id="v90" value="&lt;b&gt;Phân tích độ nhạy “chỉ SP cũ”&lt;/b&gt;&lt;br&gt;cùng mô hình đã huấn luyện, ứng viên và đáp án chỉ gồm SP cũ — gần giao thức v1, chỉ mô tả" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1105" y="654" width="440" height="100" as="geometry" /></mxCell><mxCell id="v91" value="Không dùng leave-one-out (Meng et al., 2020): ở v1, trung bình 11,2% tương tác train xảy ra sau ngày của item test → rò rỉ tương lai." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1105" y="762" width="440" height="70" as="geometry" /></mxCell><mxCell id="v92" value="Mỗi user test có nhiều SP đúng (TB 4,08) → báo cáo cả Recall@K và Precision@K, không chỉ HR@K. B2 (train lại trên train ∪ val) giữ từ v1: đo trên val, bỏ trống 4 tuần sát mốc làm NDCG@10 giảm 17–19%." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=middle;fontSize=11;fontColor=#C00000;" vertex="1" parent="1"><mxGeometry x="55" y="766" width="1020" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Mô hình NeuMF-F"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="Kiến trúc NeuMF-F và các mô hình so sánh" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#2F5597;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1380" height="28" as="geometry" /></mxCell><mxCell id="v2" value="Hợp nhất sớm (Early Fusion) MF + DNN có đặc trưng: mỗi vector = embedding ID + chiếu tuyến tính của đặc trưng — src/models/hybrid_features.py" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="1380" height="20" as="geometry" /></mxCell><mxCell id="v3" value="4 / 5" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=middle;fontSize=13;align=right;fontColor=#666666;" vertex="1" pa